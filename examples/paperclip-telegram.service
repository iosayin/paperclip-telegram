# systemd unit (Linux). Copy to /etc/systemd/system/, adjust paths and user, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now paperclip-telegram
[Unit]
Description=Paperclip Telegram bridge
After=network-online.target
Wants=network-online.target

[Service]
User=paperclip
WorkingDirectory=/opt/paperclip-telegram
EnvironmentFile=/opt/paperclip-telegram/.env
ExecStart=/usr/bin/node /opt/paperclip-telegram/src/index.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/paperclip/.paperclip-telegram

[Install]
WantedBy=multi-user.target

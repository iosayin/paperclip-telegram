# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather (or TELEGRAM_BOT_TOKEN_FILE=/path/to/file)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id. Leave empty on first run, send /start to the bot, it replies with your id.
TELEGRAM_CHAT_ID=

# Paperclip server and a board API token (or PAPERCLIP_TOKEN_FILE=/path/to/file)
PAPERCLIP_URL=http://localhost:3100
PAPERCLIP_TOKEN=

# Optional
PT_LANG=en                      # en | tr
PT_POLL_SECONDS=60              # how often to look for new cards (min 15)
PT_NOTIFY_FAILED_RUNS=true      # message when an agent run fails
PT_NOTIFY_DONE=false            # silent message when an issue is done
PT_IGNORE_RUN_ERRORS=process_lost,issue_reassigned,cancelled
PT_BACKLOG_TITLE_PREFIXES=      # comma separated; matching issues are only sent via /backlog
# PT_STATE_FILE=~/.paperclip-telegram/state.json
